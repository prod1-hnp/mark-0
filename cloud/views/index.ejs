<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cloud Print Manager | Pay & Print</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="container">
        <div class="header">
            <h1><i class="fas fa-print"></i> Cloud Printer</h1>
            <p>Professional Document Printing Service</p>
        </div>

        <% if (typeof testMode !== 'undefined' && testMode) { %>
        <div class="test-mode-banner">
            <div class="test-badge"><i class="fas fa-vial"></i> TESTING PHASE</div>
            <div class="test-banner-text">Free printing is enabled for testing. You can print directly without making any payment.</div>
        </div>
        <% } %>

        <div class="card">
            <!-- Progress Steps -->
            <div class="progress-container">
                <div class="progress-steps">
                    <div class="progress-line" id="progressLine" style="width: 0%"></div>
                    <div class="step active" id="step1">
                        <div class="step-circle">1</div>
                        <div class="step-label">Upload</div>
                    </div>
                    <div class="step" id="step2">
                        <div class="step-circle">2</div>
                        <div class="step-label">Copies & Price</div>
                    </div>
                    <div class="step" id="step3">
                        <div class="step-circle">3</div>
                        <div class="step-label">Payment</div>
                    </div>
                    <div class="step" id="step4">
                        <div class="step-circle"><i class="fas fa-check"></i></div>
                        <div class="step-label">Done</div>
                    </div>
                </div>
            </div>

            <!-- Form Content -->
            <div class="form-content">
                <!-- Step 1: Upload & Select Printer -->
                <div class="step-content active" id="content-step1">
                    <h2 class="step-title">Upload Your Document</h2>
                    <p class="step-description">Select a PDF file and choose your printer</p>

                    <div class="upload-area" id="uploadArea">
                        <div class="upload-icon">
                            <i class="fas fa-cloud-upload-alt"></i>
                        </div>
                        <div class="upload-text">Click to upload or drag and drop</div>
                        <div class="upload-hint">Any printable file up to 10MB</div>
                        <input type="file" id="pdfFile" class="file-input" multiple>
                    </div>

                    <div id="selectedFilesPreview" style="margin-top: 1rem; margin-bottom: 1rem; color: var(--text-primary); font-weight: 500;">
                        <!-- Selected files summary will appear here -->
                    </div>

                    <div class="form-group">
                        <label for="printerName">Select Printer</label>
                        <select id="printerName" class="form-control" required>
                            <option value="">Choose a printer</option>
                            <option value="HP LaserJet Pro MFP M329dw">HP LaserJet Pro MFP M329dw</option>
                            <option value="HP-LaserJet-Pro">HP-LaserJet-Pro</option>
                            <option value="Test-Printer">Test Printer</option>
                            <option value="printer-01">Office Printer 01</option>
                            <option value="printer-02">Office Printer 02</option>
                            <option value="printer-03">Color Printer</option>
                        </select>
                        <small id="printerStatusHint" style="display: block; margin-top: 0.35rem; font-size: 0.8rem; color: var(--text-secondary);"></small>
                    </div>

                    <div class="btn-group">
                        <button type="button" class="btn btn-primary" id="uploadAndNextBtn" disabled>
                            Upload & Configure Files <i class="fas fa-arrow-right"></i>
                        </button>
                    </div>
                </div>

                <!-- Step 2: Configure Files -->
                <div class="step-content" id="content-step2">
                    <h2 class="step-title">Configure Print Settings</h2>
                    <p class="step-description">Select copies and color options for each file</p>

                    <div id="filesConfigList" style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 2rem;">
                        <!-- File config cards will be generated here -->
                    </div>

                    <div class="pricing-card">
                        <div class="pricing-row">
                            <span class="pricing-label">Total Files</span>
                            <span class="pricing-value" id="pricingTotalFiles">0</span>
                        </div>
                        <div class="pricing-row">
                            <span class="pricing-label">Total Amount</span>
                            <span class="pricing-value">₹<span id="totalAmount">0</span></span>
                        </div>
                    </div>

                    <div class="btn-group">
                        <button type="button" class="btn btn-secondary" id="backStep2">
                            <i class="fas fa-arrow-left"></i> Back
                        </button>
                        <button type="button" class="btn btn-test" id="testPrintStep2Btn">
                            <i class="fas fa-bolt"></i> Print Without Payment (Test Mode)
                        </button>
                        <button type="button" class="btn btn-primary" id="nextStep2">
                            Proceed to Payment <i class="fas fa-arrow-right"></i>
                        </button>
                    </div>
                </div>

                <!-- Step 3: Payment -->
                <div class="step-content" id="content-step3">
                    <h2 class="step-title">Payment</h2>
                    <p class="step-description">Review your order and make payment</p>

                    <div class="success-details">
                        <div class="detail-row">
                            <span class="detail-label">Document</span>
                            <span class="detail-value" id="summaryFile">-</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Printer</span>
                            <span class="detail-value" id="summaryPrinter">-</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Pages</span>
                            <span class="detail-value" id="summaryPages">-</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Copies</span>
                            <span class="detail-value" id="summaryCopies">-</span>
                        </div>
                        <div class="detail-row" style="border-top: 2px solid var(--border); padding-top: 1rem; margin-top: 0.5rem;">
                            <span class="detail-label" style="font-size: 1.125rem; font-weight: 700;">Total</span>
                            <span class="detail-value" style="font-size: 1.5rem; color: var(--primary);">₹<span id="summaryTotal">0</span></span>
                        </div>
                    </div>

                    <div class="btn-group">
                        <button type="button" class="btn btn-secondary" id="backStep3">
                            <i class="fas fa-arrow-left"></i> Back
                        </button>
                        <button type="button" class="btn btn-test" id="testPrintStep3Btn" style="font-weight: 600;">
                            <i class="fas fa-print"></i> Print Without Payment (Test Mode)
                        </button>
                        <button type="button" class="btn btn-success" id="payNowBtn">
                            <i class="fas fa-lock"></i> Pay Now
                        </button>
                    </div>
                </div>

                <!-- Step 4: Success -->
                <div class="step-content" id="content-step4">
                    <div class="success-content">
                        <div class="success-icon">
                            <i class="fas fa-check"></i>
                        </div>
                        <h2 class="step-title" id="successTitle">Print Job Sent!</h2>
                        <p class="step-description" id="successDesc">Your document has been sent to the printer</p>

                        <div class="success-details">
                            <div class="detail-row">
                                <span class="detail-label">Job ID</span>
                                <span class="detail-value" id="successJobId">-</span>
                            </div>
                            <div class="detail-row">
                                <span class="detail-label">Document</span>
                                <span class="detail-value" id="successFile">-</span>
                            </div>
                            <div class="detail-row">
                                <span class="detail-label">Printer</span>
                                <span class="detail-value" id="successPrinter">-</span>
                            </div>
                            <div class="detail-row">
                                <span class="detail-label">Copies</span>
                                <span class="detail-value" id="successCopies">-</span>
                            </div>
                            <div class="detail-row">
                                <span class="detail-label">Amount Paid</span>
                                <span class="detail-value" style="color: var(--success);">₹<span id="successAmount">0</span></span>
                            </div>
                        </div>

                        <div class="btn-group">
                            <button type="button" class="btn btn-primary" id="printAnother">
                                <i class="fas fa-plus"></i> Print Another Document
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Notification -->
    <div class="notification" id="notification">
        <div class="notification-icon" id="notificationIcon">
            <i class="fas fa-info-circle"></i>
        </div>
        <div>
            <div id="notificationTitle" style="font-weight: 600; margin-bottom: 0.25rem;">Notification</div>
            <div id="notificationMessage" style="font-size: 0.875rem; color: var(--secondary);"></div>
        </div>
    </div>

    <script>
        const state = {
            currentStep: 1,
            stagedFiles: [], // Array of File objects selected in Step 1
            files: [], // Array of { fileId, originalName, pageCount, copies, color } uploaded
            printerName: '',
            amount: 0,
            batchId: null,
            orderId: null,
            razorpayKey: ''
        };

        // DOM Elements
        const uploadArea = document.getElementById('uploadArea');
        const fileInput = document.getElementById('pdfFile');
        const printerSelect = document.getElementById('printerName');
        const uploadAndNextBtn = document.getElementById('uploadAndNextBtn');
        const filesConfigList = document.getElementById('filesConfigList');
        const pricingTotalFiles = document.getElementById('pricingTotalFiles');
        
        const backStep2Btn = document.getElementById('backStep2');
        const nextStep2Btn = document.getElementById('nextStep2');
        const testPrintStep2Btn = document.getElementById('testPrintStep2Btn');
        const backStep3Btn = document.getElementById('backStep3');
        const testPrintStep3Btn = document.getElementById('testPrintStep3Btn');
        const payNowBtn = document.getElementById('payNowBtn');
        const printAnotherBtn = document.getElementById('printAnother');

        // Upload area click
        uploadArea.addEventListener('click', () => fileInput.click());

        // File selection
        fileInput.addEventListener('change', async (e) => {
            if (e.target.files.length > 0) {
                appendStagedFiles(e.target.files);
                fileInput.value = ''; // Reset input so same file can be selected again
            }
        });

        // Drag and drop
        uploadArea.addEventListener('dragover', (e) => {
            e.preventDefault();
            uploadArea.classList.add('drag-over');
        });

        uploadArea.addEventListener('dragleave', () => {
            uploadArea.classList.remove('drag-over');
        });

        uploadArea.addEventListener('drop', async (e) => {
            e.preventDefault();
            uploadArea.classList.remove('drag-over');
            
            if (e.dataTransfer.files.length > 0) {
                appendStagedFiles(e.dataTransfer.files);
            }
        });

        function appendStagedFiles(fileList) {
            for (let i = 0; i < fileList.length; i++) {
                if (fileList[i].size > 10 * 1024 * 1024) {
                    showNotification('File too large', `File ${fileList[i].name} exceeds 10MB limit`, 'error');
                } else {
                    state.stagedFiles.push(fileList[i]);
                }
            }
            updateSelectedFilesPreview();
            checkStep1Complete();
        }

        function removeStagedFile(index) {
            state.stagedFiles.splice(index, 1);
            updateSelectedFilesPreview();
            checkStep1Complete();
        }

        function updateSelectedFilesPreview() {
            const preview = document.getElementById('selectedFilesPreview');
            if (state.stagedFiles.length > 0) {
                let html = `<div style="margin-bottom: 0.5rem;"><i class="fas fa-check-circle" style="color: var(--success); margin-right: 0.5rem;"></i> ${state.stagedFiles.length} file(s) selected:</div>`;
                html += `<div style="display: flex; flex-direction: column; gap: 0.5rem; max-height: 150px; overflow-y: auto;">`;
                state.stagedFiles.forEach((f, idx) => {
                    html += `
                        <div style="display: flex; justify-content: space-between; align-items: center; background: var(--bg-secondary); padding: 0.5rem; border-radius: 4px; border: 1px solid var(--border);">
                            <span style="font-size: 0.875rem; color: var(--text-secondary); text-overflow: ellipsis; overflow: hidden; white-space: nowrap; max-width: 80%;">${f.name}</span>
                            <button type="button" onclick="removeStagedFile(${idx})" style="background: none; border: none; color: var(--error); cursor: pointer;"><i class="fas fa-times"></i></button>
                        </div>
                    `;
                });
                html += `</div>`;
                preview.innerHTML = html;
            } else {
                preview.innerHTML = '';
            }
        }

        // Handle file selection and upload
        // Handle multiple files upload
        async function handleFilesUpload() {
            if (state.stagedFiles.length === 0) {
                showNotification('No files', 'Please select at least one file', 'error');
                return;
            }

            uploadAndNextBtn.disabled = true;
            uploadAndNextBtn.innerHTML = '<div class="spinner"></div> Uploading...';

            try {
                const formData = new FormData();
                for (let i = 0; i < state.stagedFiles.length; i++) {
                    formData.append('files', state.stagedFiles[i]);
                }

                const response = await fetch('/upload', {
                    method: 'POST',
                    body: formData
                });

                const data = await response.json();

                if (data.success) {
                    let grayscaleCount = 0;
                    state.files = data.files.map(f => {
                        // Auto-select B&W if server detected grayscale image
                        const autoColor = f.isColorDocument === true;
                        if (f.isColorDocument === false) grayscaleCount++;
                        return {
                            ...f,
                            copies: 1,
                            color: autoColor,
                            duplex: false
                        };
                    });
                    renderFilesConfigList();
                    goToStep(2);
                    let msg = `${state.files.length} files uploaded`;
                    if (grayscaleCount > 0) {
                        msg += `. ${grayscaleCount} file(s) detected as B&W — auto-set to Black & White (₹2/page) to save cost`;
                    }
                    showNotification('Upload successful', msg, 'success');
                } else {
                    showNotification('Upload failed', data.error || 'Unknown error', 'error');
                }
            } catch (error) {
                showNotification('Network error', 'Please check your connection', 'error');
            } finally {
                uploadAndNextBtn.disabled = false;
                uploadAndNextBtn.innerHTML = 'Upload & Configure Files <i class="fas fa-arrow-right"></i>';
            }
        }

        // Render file config cards
        function renderFilesConfigList() {
            filesConfigList.innerHTML = '';
            
            state.files.forEach((file, index) => {
                const card = document.createElement('div');
                card.style.cssText = 'background: var(--bg-main); border: 1px solid var(--border); border-radius: 8px; padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem;';
                
                const colorHint = file.isColorDocument === false
                    ? `<div style="display: flex; align-items: center; gap: 0.5rem; padding: 0.4rem 0.75rem; background: #fef3c7; border: 1px solid #f59e0b; border-radius: 6px; font-size: 0.8rem; color: #92400e;">
                        <i class="fas fa-info-circle"></i> Detected as B&W — Color printing would waste money
                       </div>`
                    : file.isColorDocument === true
                    ? `<div style="display: flex; align-items: center; gap: 0.5rem; padding: 0.4rem 0.75rem; background: #dbeafe; border: 1px solid #3b82f6; border-radius: 6px; font-size: 0.8rem; color: #1e40af;">
                        <i class="fas fa-palette"></i> Detected as Color document
                       </div>`
                    : '';

                card.innerHTML = `
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <div style="font-weight: 600; color: var(--text-primary);"><i class="fas fa-file-pdf" style="color: var(--primary); margin-right: 0.5rem;"></i> ${file.originalName}</div>
                        <div style="font-size: 0.875rem; color: var(--text-secondary);">${file.pageCount} pages</div>
                    </div>
                    ${colorHint}
                    <div style="display: flex; gap: 2rem; align-items: center; border-top: 1px solid var(--border); padding-top: 1rem; flex-wrap: wrap;">
                        <div style="display: flex; align-items: center; gap: 1rem;">
                            <label style="font-size: 0.875rem; font-weight: 500;">Copies:</label>
                            <div style="display: flex; gap: 0.5rem; align-items: center;">
                                <button type="button" class="copies-btn" style="width: 32px; height: 32px;" onclick="updateFileCopies(${index}, -1)"><i class="fas fa-minus"></i></button>
                                <span style="font-weight: 600; min-width: 24px; text-align: center;">${file.copies}</span>
                                <button type="button" class="copies-btn" style="width: 32px; height: 32px;" onclick="updateFileCopies(${index}, 1)"><i class="fas fa-plus"></i></button>
                            </div>
                        </div>
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <label style="font-size: 0.875rem; font-weight: 500;">Color Mode:</label>
                            <select onchange="updateFileColor(${index}, this.value === 'true')" class="form-control" style="padding: 0.4rem; height: auto;">
                                <option value="false" ${!file.color ? 'selected' : ''}>Black & White (₹2/page)</option>
                                <option value="true" ${file.color ? 'selected' : ''}>Color (₹5/page)</option>
                            </select>
                        </div>
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <label style="font-size: 0.875rem; font-weight: 500;"><i class="fas fa-copy" style="margin-right: 0.25rem;"></i>Sides:</label>
                            <select onchange="updateFileDuplex(${index}, this.value === 'true')" class="form-control" style="padding: 0.4rem; height: auto;">
                                <option value="false" ${!file.duplex ? 'selected' : ''}>1-Sided</option>
                                <option value="true" ${file.duplex ? 'selected' : ''}>2-Sided (Duplex)</option>
                            </select>
                        </div>
                    </div>
                `;
                filesConfigList.appendChild(card);
            });
            updatePricing();
        }

        window.updateFileCopies = (index, change) => {
            const file = state.files[index];
            if (file.copies + change >= 1 && file.copies + change <= 100) {
                file.copies += change;
                renderFilesConfigList();
            }
        };

        window.updateFileColor = (index, isColor) => {
            const file = state.files[index];
            // Warn if user selects Color on a detected-grayscale file
            if (isColor && file.isColorDocument === false) {
                showNotification('⚠️ Grayscale file', `"${file.originalName}" was detected as B&W. Selecting Color will cost ₹5/page instead of ₹2/page with no visual difference.`, 'error');
            }
            file.color = isColor;
            updatePricing();
        };

        window.updateFileDuplex = (index, isDuplex) => {
            state.files[index].duplex = isDuplex;
            renderFilesConfigList();
        };

        function checkStep1Complete() {
            const isComplete = state.stagedFiles.length > 0 && printerSelect.value;
            uploadAndNextBtn.disabled = !isComplete;
        }

        printerSelect.addEventListener('change', (e) => {
            state.printerName = e.target.value;
            checkStep1Complete();
        });

        uploadAndNextBtn.addEventListener('click', handleFilesUpload);

        backStep2Btn.addEventListener('click', () => goToStep(1));

        nextStep2Btn.addEventListener('click', async () => {
            await createOrder();
        });

        backStep3Btn.addEventListener('click', () => goToStep(2));

        function updatePricing() {
            let totalAmount = 0;
            state.files.forEach(file => {
                const pricePerPage = file.color ? 5 : 2;
                totalAmount += (file.pageCount * pricePerPage) * file.copies;
            });
            state.amount = totalAmount;

            pricingTotalFiles.textContent = state.files.length;
            document.getElementById('totalAmount').textContent = totalAmount;

            document.getElementById('summaryFile').textContent = `${state.files.length} Files`;
            document.getElementById('summaryPrinter').textContent = state.printerName;
            
            const totalPages = state.files.reduce((sum, f) => sum + f.pageCount, 0);
            const totalCopies = state.files.reduce((sum, f) => sum + f.copies, 0);
            document.getElementById('summaryPages').textContent = `${totalPages} total pages`;
            document.getElementById('summaryCopies').textContent = `${totalCopies} total copies`;
            document.getElementById('summaryTotal').textContent = totalAmount;
        }

        // Create Razorpay order
        // Create Razorpay order
        async function createOrder() {
            nextStep2Btn.disabled = true;
            nextStep2Btn.innerHTML = '<div class="spinner"></div> Creating order...';

            try {
                const response = await fetch('/checkout-batch', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        items: state.files,
                        printerName: state.printerName,
                        autoPrint: 'false'
                    })
                });

                const data = await response.json();

                if (data.success) {
                    state.orderId = data.orderId;
                    state.batchId = data.batchId;
                    state.razorpayKey = data.key;

                    goToStep(3);
                    showNotification('Order created', 'Proceed to payment', 'success');
                } else {
                    showNotification('Order failed', data.error || 'Unknown error', 'error');
                }
            } catch (error) {
                showNotification('Network error', 'Please check your connection', 'error');
            } finally {
                nextStep2Btn.disabled = false;
                nextStep2Btn.innerHTML = 'Proceed to Payment <i class="fas fa-arrow-right"></i>';
            }
        }

        // Execute Print without payment (Test Mode / Autonomous)
        async function executeTestPrint(btn) {
            if (state.files.length === 0) {
                showNotification('Missing files', 'Please upload files first', 'error');
                return;
            }

            if (!state.printerName) {
                showNotification('Missing printer', 'Please choose a printer', 'error');
                return;
            }

            const originalBtnHtml = btn ? btn.innerHTML : '';
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<div class="spinner"></div> Dispatching to printer...';
            }

            try {
                const response = await fetch('/checkout-batch', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        items: state.files,
                        printerName: state.printerName,
                        autoPrint: 'true'
                    })
                });

                const data = await response.json();

                if (data.success) {
                    document.getElementById('successJobId').textContent = data.batchId;
                    document.getElementById('successFile').textContent = `${state.files.length} Files`;
                    document.getElementById('successPrinter').textContent = state.printerName;
                    document.getElementById('successCopies').textContent = '-';
                    document.getElementById('successAmount').textContent = '0 (Free - Testing Phase)';

                    goToStep(4);
                    showNotification('Print job sent!', 'Sent to printer without payment', 'success');
                } else {
                    showNotification('Print failed', data.error || 'Failed to dispatch print job', 'error');
                }
            } catch (error) {
                showNotification('Network error', 'Please check your connection', 'error');
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = originalBtnHtml;
                }
            }
        }

        // Test mode buttons
        if (testPrintStep2Btn) {
            testPrintStep2Btn.addEventListener('click', () => executeTestPrint(testPrintStep2Btn));
        }

        if (testPrintStep3Btn) {
            testPrintStep3Btn.addEventListener('click', () => {
                showNotification('Testing Mode', 'Bypassing payment and sending to printer...', 'info');
                verifyPayment({
                    razorpay_order_id: state.orderId || `order_test_${Date.now()}`,
                    razorpay_payment_id: `pay_test_${Date.now()}`,
                    razorpay_signature: 'test_signature'
                });
            });
        }

        // Process payment (with automatic test-mode bypass fallback)
        payNowBtn.addEventListener('click', () => {
            const isDummyKey = !state.razorpayKey || 
                state.razorpayKey === 'rzp_test_dummy_key' || 
                state.razorpayKey.includes('<') ||
                state.orderId?.startsWith('order_test_');

            if (isDummyKey) {
                showNotification('Testing Mode', 'Bypassing payment and sending to printer...', 'info');
                verifyPayment({
                    razorpay_order_id: state.orderId || `order_test_${Date.now()}`,
                    razorpay_payment_id: `pay_test_${Date.now()}`,
                    razorpay_signature: 'test_signature'
                });
                return;
            }

            const options = {
                key: state.razorpayKey,
                amount: state.amount * 100,
                currency: 'INR',
                name: 'Cloud Printer',
                description: `Print ${state.originalName}`,
                order_id: state.orderId,
                handler: async function (response) {
                    await verifyPayment(response);
                },
                prefill: {
                    name: 'User',
                    email: 'user@example.com'
                },
                theme: {
                    color: '#2563eb'
                }
            };

            const rzp = new Razorpay(options);
            rzp.open();
        });

        // Verify payment
        async function verifyPayment(response) {
            try {
                const verifyResponse = await fetch('/verify-payment', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        razorpay_order_id: response.razorpay_order_id,
                        razorpay_payment_id: response.razorpay_payment_id,
                        razorpay_signature: response.razorpay_signature,
                        batchId: state.batchId
                    })
                });

                const data = await verifyResponse.json();

                if (data.success) {
                    document.getElementById('successJobId').textContent = data.batchId;
                    document.getElementById('successFile').textContent = `${state.files.length} Files`;
                    document.getElementById('successPrinter').textContent = state.printerName;
                    document.getElementById('successCopies').textContent = '-';
                    document.getElementById('successAmount').textContent = state.amount;

                    goToStep(4);
                    showNotification('Payment successful!', 'Your documents are being printed', 'success');
                } else {
                    showNotification('Payment verification failed', data.error, 'error');
                }
            } catch (error) {
                showNotification('Verification error', 'Please contact support', 'error');
            }
        }

        // Print another document
        printAnotherBtn.addEventListener('click', () => {
            location.reload();
        });

        // Step navigation
        function goToStep(stepNumber) {
            state.currentStep = stepNumber;

            // Hide all steps
            document.querySelectorAll('.step-content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.step').forEach(el => {
                el.classList.remove('active');
                el.classList.remove('completed');
            });

            // Show current step
            document.getElementById(`content-step${stepNumber}`).classList.add('active');
            document.getElementById(`step${stepNumber}`).classList.add('active');

            // Mark completed steps
            for (let i = 1; i < stepNumber; i++) {
                document.getElementById(`step${i}`).classList.add('completed');
            }

            // Update progress line
            const progress = ((stepNumber - 1) / 3) * 100;
            document.getElementById('progressLine').style.width = `${progress}%`;
        }

        // Helper functions
        function formatFileSize(bytes) {
            if (bytes === 0) return '0 Bytes';
            const k = 1024;
            const sizes = ['Bytes', 'KB', 'MB', 'GB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
        }

        function showNotification(title, message, type) {
            const notification = document.getElementById('notification');
            const notificationTitle = document.getElementById('notificationTitle');
            const notificationMessage = document.getElementById('notificationMessage');
            const notificationIcon = document.getElementById('notificationIcon');
            
            notificationTitle.textContent = title;
            notificationMessage.innerHTML = message;
            
            notification.className = 'notification';
            notification.classList.add(type);
            
            const icon = notificationIcon.querySelector('i');
            icon.className = type === 'success' ? 'fas fa-check-circle' :
                            type === 'error' ? 'fas fa-exclamation-circle' :
                            'fas fa-info-circle';
            
            notification.classList.add('show');
            
            setTimeout(() => {
                notification.classList.remove('show');
            }, 5000);
        }

        // Fetch live connected printers
        async function loadConnectedPrinters() {
            try {
                const res = await fetch('/api/printers');
                const data = await res.json();
                if (data && data.printers && data.printers.length > 0) {
                    const hint = document.getElementById('printerStatusHint');
                    if (hint) {
                        hint.innerHTML = `<span style="color: #059669; font-weight: 600;">● Online:</span> ${data.printers.join(', ')}`;
                    }
                    data.printers.forEach(printer => {
                        let exists = false;
                        for (let opt of printerSelect.options) {
                            if (opt.value === printer) {
                                if (!opt.textContent.includes('Online')) {
                                    opt.textContent = `${printer} (● Online)`;
                                }
                                exists = true;
                                break;
                            }
                        }
                        if (!exists) {
                            const option = document.createElement('option');
                            option.value = printer;
                            option.textContent = `${printer} (● Online)`;
                            printerSelect.appendChild(option);
                        }
                    });

                    // Auto-select if only 1 connected printer and none selected
                    if (data.printers.length === 1 && !printerSelect.value) {
                        printerSelect.value = data.printers[0];
                        state.printerName = data.printers[0];
                        checkStep1Complete();
                    }
                } else {
                    const hint = document.getElementById('printerStatusHint');
                    if (hint) {
                        hint.innerHTML = `<span style="color: #dc2626; font-weight: 500;">⚠ No printer agents connected. Start the printer agent to print.</span>`;
                    }
                }
            } catch (err) {
                console.warn('Could not load connected printers', err);
            }
        }
        loadConnectedPrinters();
        setInterval(loadConnectedPrinters, 3000);
    </script>
</body>
</html>
