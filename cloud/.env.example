PORT=<port number>
DB_URL=mongodb+srv://username:password@cluster.mongodb.net/cloudprinter?retryWrites=true&w=majority
RAZORPAY_KEY_ID=<razorpay key id>
RAZORPAY_KEY_SECRET=<razorpay key secret>

# API Key for protecting sensitive endpoints (leave empty to disable auth)
API_KEY=<your-secret-api-key>

# Comma-separated list of allowed CORS origins (defaults to http://localhost:3000)
CORS_ORIGINS=http://localhost:3000